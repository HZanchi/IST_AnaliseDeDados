# Conexão com o banco de dados de qualidade de água (PostgreSQL).
#
# Banco portátil via Docker (ver docker-compose.yml na raiz do projeto):
#   docker compose up -d
# As credenciais abaixo batem com as do docker-compose.yml.
# Porta 5433 no host para não conflitar com um PostgreSQL já instalado (5432).
DATABASE_URL=postgres://waterquality:waterquality@127.0.0.1:5433/waterquality

# Porta do dashboard (opcional)
# PORT=3000
# HOST=127.0.0.1
